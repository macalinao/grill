{
  "name": "@macalinao/grill-monorepo",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "author": "Ian Macalinao <me@ianm.com>",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalogs": {
      "peer": {
        "@solana/kit": "^8.4.0",
        "@tanstack/react-query": "^5.103.2",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "zod": "^4.6.5",
        "@solana/react": "^8.4.0",
        "@solana/web3.js": "^1.98.4"
      }
    },
    "catalog": {
      "typescript": "^7.0.2",
      "@macalinao/tsconfig": "^4.0.0",
      "@solana/kit": "^8.4.0",
      "tslib": "^2.8.1",
      "@tanstack/react-query": "^5.103.2",
      "@solana/wallet-adapter-base": "^0.9.28",
      "@solana/wallet-adapter-react": "^0.15.40",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "@types/bun": "^1.4.2",
      "tsdown": "^0.23.0",
      "@solana/react": "^8.4.0",
      "@solana/kit-plugin-rpc": "^0.19.0",
      "@solana/webcrypto-ed25519-polyfill": "^8.4.0",
      "@solana/wallet-adapter-react-ui": "^0.9.40",
      "@solana/wallet-adapter-wallets": "^0.19.39",
      "@solana/web3.js": "^1.99.0",
      "@solana/spl-token": "^0.4.15",
      "@solana-program/address-lookup-table": "^0.15.0",
      "@solana-program/compute-budget": "^0.19.0",
      "@solana-program/system": "^0.15.0",
      "@solana-program/token": "^0.17.0",
      "@solana-program/token-2022": "^0.19.0",
      "@solana-programs/meteora-damm-v2": "^0.5.1",
      "@solana-programs/quarry": "^0.8.1",
      "@solana-programs/token-metadata": "^0.9.1"
    }
  },
  "scripts": {
    "build": "turbo build",
    "build:packages": "turbo build --filter='./packages/**'",
    "build:watch": "turbo watch build",
    "build:watch:packages": "turbo watch build --filter='./packages/**'",
    "lint": "turbo build && ast-grep scan && oxlint --type-aware && oxfmt --check && turbo run typecheck",
    "lint:fix": "turbo build && ast-grep scan --update-all && oxlint --type-aware --fix && oxfmt && turbo run typecheck",
    "lint:ci": "oxlint --type-aware --format=github && oxfmt --check && turbo run typecheck",
    "clean": "turbo run clean && rm -fr node_modules/",
    "test": "CI=true turbo run test",
    "watch": "turbo watch build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "ci:version": "changeset version && bun update",
    "ci:publish": "./scripts/ci-publish.sh",
    "prepare": "husky",
    "codegen": "turbo run codegen",
    "format": "oxfmt",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@changesets/cli": "^3.0.3",
    "@rolldown/plugin-babel": "^0.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "tsdown": "^0.23.0",
    "turbo": "^2.11.2",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1"
  },
  "packageManager": "bun@1.4.2",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs,cts,mts}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,html,css}": "oxfmt"
  },
  "overrides": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "lodash-es": "^4.18.1"
  }
}
