{
  "name": "@macalinao/gill-extra",
  "version": "0.14.0",
  "description": "Solana client utilities built on @solana/kit - no React dependencies",
  "type": "module",
  "sideEffects": false,
  "author": "Ian Macalinao <me@ianm.com>",
  "homepage": "https://grill.ianm.com",
  "license": "Apache-2.0",
  "keywords": [
    "solana",
    "utilities",
    "dataloader",
    "batching",
    "esm",
    "typescript",
    "ian-macalinao"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macalinao/grill.git",
    "directory": "packages/gill-extra"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -fr dist/ node_modules/ tsconfig.tsbuildinfo",
    "test": "bun test src/"
  },
  "dependencies": {
    "@macalinao/dataloader-es": "workspace:^",
    "@macalinao/solana-batch-accounts-loader": "workspace:^",
    "@macalinao/solana-errors": "workspace:^",
    "@macalinao/token-utils": "workspace:^",
    "@macalinao/zod-solana": "workspace:^",
    "@solana-program/system": "catalog:",
    "@solana-program/token": "catalog:",
    "@solana-programs/token-metadata": "catalog:"
  },
  "devDependencies": {
    "@macalinao/tsconfig": "catalog:",
    "@solana-program/compute-budget": "catalog:",
    "@solana/accounts": "catalog:",
    "@solana/addresses": "catalog:",
    "@solana/codecs-core": "catalog:",
    "@solana/codecs-strings": "catalog:",
    "@solana/errors": "catalog:",
    "@solana/functional": "catalog:",
    "@solana/instructions": "catalog:",
    "@solana/keys": "catalog:",
    "@solana/kit": "catalog:",
    "@solana/rpc-api": "catalog:",
    "@solana/rpc-spec": "catalog:",
    "@solana/rpc-subscriptions-api": "catalog:",
    "@solana/rpc-subscriptions-spec": "catalog:",
    "@solana/rpc-types": "catalog:",
    "@solana/signers": "catalog:",
    "@solana/transaction-messages": "catalog:",
    "@solana/transactions": "catalog:",
    "@types/bun": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@solana/accounts": "catalog:peer",
    "@solana/addresses": "catalog:peer",
    "@solana/codecs-core": "catalog:peer",
    "@solana/codecs-strings": "catalog:peer",
    "@solana/instructions": "catalog:peer",
    "@solana/keys": "catalog:peer",
    "@solana/kit": "catalog:peer",
    "@solana/rpc-api": "catalog:peer",
    "@solana/rpc-spec": "catalog:peer",
    "@solana/rpc-subscriptions-api": "catalog:peer",
    "@solana/rpc-subscriptions-spec": "catalog:peer",
    "@solana/rpc-types": "catalog:peer",
    "@solana/signers": "catalog:peer",
    "@solana/transaction-messages": "catalog:peer",
    "@solana/transactions": "catalog:peer"
  }
}
