{
  "name": "@macalinao/wallet-adapter-compat",
  "version": "14.3.0",
  "description": "Compatibility layer that bridges @solana/wallet-adapter with @solana/kit and grill",
  "type": "module",
  "sideEffects": false,
  "author": "Ian Macalinao <me@ianm.com>",
  "homepage": "https://grill.ianm.com",
  "license": "Apache-2.0",
  "keywords": [
    "solana",
    "wallet",
    "adapter",
    "kit",
    "blockchain",
    "web3",
    "compatibility",
    "ian-macalinao"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macalinao/grill.git",
    "directory": "packages/wallet-adapter-compat"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/",
    "clean": "rm -fr dist/ node_modules/ tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@solana/webcrypto-ed25519-polyfill": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@macalinao/gill-extra": "workspace:^",
    "@macalinao/grill": "workspace:^",
    "@macalinao/tsconfig": "catalog:",
    "@solana/addresses": "catalog:",
    "@solana/codecs-strings": "catalog:",
    "@solana/instructions": "catalog:",
    "@solana/keys": "catalog:",
    "@solana/kit": "catalog:",
    "@solana/react": "catalog:",
    "@solana/rpc-types": "catalog:",
    "@solana/signers": "catalog:",
    "@solana/transaction-messages": "catalog:",
    "@solana/transactions": "catalog:",
    "@solana/web3.js": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@macalinao/grill": "workspace:^",
    "@solana/addresses": "catalog:peer",
    "@solana/codecs-strings": "catalog:peer",
    "@solana/keys": "catalog:peer",
    "@solana/kit": "catalog:peer",
    "@solana/react": "catalog:peer",
    "@solana/signers": "catalog:peer",
    "@solana/transaction-messages": "catalog:peer",
    "@solana/transactions": "catalog:peer",
    "@solana/wallet-adapter-base": "catalog:",
    "@solana/wallet-adapter-react": "catalog:",
    "@solana/web3.js": "catalog:peer",
    "react": "catalog:peer",
    "react-dom": "catalog:peer"
  }
}
